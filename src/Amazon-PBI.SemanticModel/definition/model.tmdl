model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Erros nas consultas que foram carregadas em 07/05/2026 13:50:58.
queryGroup 'Erros na Consulta - 07/05/2026 13:50:58'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["amazon","Erros em amazon"]

annotation PBI_ProTooling = ["DevMode"]

ref table amazon

ref cultureInfo pt-BR

